{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@attp/core": ["../typescript/attp/core/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": ["src/logic.ts", "src/chat_logic.ts", "src/views/HomeView.ts", "src/views/SessionsView.ts", "src/views/NodeView.ts", "src/views/SettingsView.ts", "src/components/Sidebar.ts", "src/components/Modals.ts", "src/components/AddAgentModal.ts"]
}