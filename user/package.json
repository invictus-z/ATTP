{
  "name": "attp-trace-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "clean": "rm -rf node_modules package-lock.json",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:prod": "vite build && electron .",
    "electron": "electron .",
    "electron:build": "tsc && vite build && electron-builder"
  },
  "build": {
    "appId": "com.attp.nanobot-workspace",
    "productName": "Nanobot Agent Workspace",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/estree": "^1.0.8",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "lucide": "^0.359.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "electron-store": "^11.0.2"
  }
}
