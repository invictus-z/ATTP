{
  "name": "@invictus-z/attp",
  "version": "0.2.0-alpha.0",
  "description": "ATTP SDK for TypeScript — authentication, provenance & session management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "attp",
    "authentication",
    "provenance",
    "session",
    "nanobot"
  ],
  "license": "MIT",
  "devDependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/ed25519": "^2.0.0",
    "@noble/hashes": "^1.5.0",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.0.0",
    "typescript": "^5.2.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  }
}
