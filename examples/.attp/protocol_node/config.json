{
    "web": {
        "host": "0.0.0.0",
        "port": 9000
    },
    "storage": {
        "dataDir": "~/.attp/protocol_node",
        "dbPath": "attp.db"
    },
    "analysis": {
        "enabled": true,
        "apiKey": "${LLM_API_KEY}",
        "baseUrl": "${LLM_BASE_URL}",
        "model": "${LLM_MODEL}",
        "reportBatchSize": 10,
        "horizontalEnabled": true,
        "horizontalThreshold": 5
    }
}
